---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const lista = await getCollection('guias');
  return lista.map((entrada) => ({ params: { id: entrada.id }, props: { entrada } }));
}
const { entrada } = Astro.props;
const { Content } = await render(entrada);
---
<Base titulo={entrada.data.titulo} descripcion={entrada.data.resumen}>
  <article class="prose">
    <a href="/guias">← Guías</a>
    <h1>{entrada.data.titulo}</h1>
    <Content />
  </article>
</Base>
