  ],
  bandera: [
    'drrrrrr.',
    'drrhrrr.',
    'drhhhrr.',
    'drrhrrr.',
    'drrrrrr.',
    'd.......',
    'd.......',
    'd.......',
  ],
  bloque: [
    'gggggggg',
    'glggggLg',
    'gdgdggdg',
    'dddddddd',
    'ddedddde',
    'dddddddd',
    'deddddde',
    'dddddedd',
  ],
  antorcha: [
    '.y.',
    'yoy',
    '.o.',
    '.d.',
    '.d.',
    '.d.',
    '.d.',
  ],
  libro: [
    '.bbbbbb.',
    'bccccccb',
    'bcxxxxcb',
    'bccccccb',
    'bcxxxxcb',
    'bccccccb',
    'brrrrrrb',
    '.bbbbbb.',
  ],
  reloj: [
    '..hhhh..',
    '.hnnnnh.',
    'hnnnyynh',
    'hnngyynh',
    'hggggggh',
    'hgglgggh',
    '.hggggh.',
    '..hhhh..',
  ],
};
colores.L = '#8ee05a';

const { nombre, tam = 28, class: clase } = Astro.props;
const filas = iconos[nombre] ?? [];
const ancho = Math.max(...filas.map((f) => f.length));
const celdas = filas.flatMap((fila, y) =>
  [...fila].map((ch, x) => ({ x, y, color: colores[ch] })).filter((c) => c.color),
);
---
<svg class:list={['pixel', clase]} width={tam} height={(tam * filas.length) / ancho} viewBox={`0 0 ${ancho} ${filas.length}`} shape-rendering="crispEdges" aria-hidden="true">
  {celdas.map((c) => <rect x={c.x} y={c.y} width="1.02" height="1.02" fill={c.color} />)}
</svg>
